# API
PORT=3001
JWT_SECRET=change-me-in-development

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ithaca:ithaca@localhost:5433/ithaca

# Web (Vite)
VITE_API_URL=http://localhost:3001

# EXA API
EXA_API_KEY=your-exa-api-key

# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# SMTP (Mailpit in docker-compose.yml)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=outreach@ithaca.example
