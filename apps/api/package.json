{
  "name": "@ithaca/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ithaca/db": "workspace:*",
    "@ithaca/email": "workspace:*",
    "@ithaca/security": "workspace:*",
    "@ithaca/orchestrator": "workspace:*",
    "@ithaca/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@ithaca/eslint-config": "workspace:*",
    "@ithaca/tsconfig": "workspace:*",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
